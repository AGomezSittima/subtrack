<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="error"/>
  <module name="TreeWalker">
    <module name="TodoComment">
      <property name="format" value="\b(TODO(?!\(#\d+\))|FIXME|XXX|HACK)\b"/>
      <message key="todo.match" value="Write TODO(#&lt;issue&gt;): link a GitHub issue; FIXME, XXX and HACK are not used."/>
    </module>
  </module>
</module>
