# Optional local settings. Copy to .env (git-ignored) and uncomment what you need.
# Read by Docker Compose, the justfile recipes and the Vite dev server.

# Host port for the app at http://127.0.0.1:<port>. Default: 8080.
# SUBTRACK_PORT=8080

# Host port for the local API docs (Swagger UI) at http://127.0.0.1:<port>, started by `just dev`.
# Default: 8081.
# SUBTRACK_DOCS_PORT=8081
