{
  "name": "@subtrack/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subtrack OpenAPI contract and the TypeScript types generated from it",
  "exports": {
    ".": {
      "types": "./generated/openapi.d.ts"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.yaml --redocly redocly.gen.yaml --output generated/openapi.d.ts",
    "lint": "redocly lint openapi.yaml && node scripts/validate-cases.ts && tsc --noEmit"
  },
  "devDependencies": {
    "@redocly/cli": "2.76.0",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
