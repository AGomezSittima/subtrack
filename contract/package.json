{
  "name": "@subtrack/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subtrack OpenAPI contract and the TypeScript types generated from it",
  "exports": {
    ".": {
      "types": "./generated/openapi.d.ts"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.yaml --output generated/openapi.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
