{
  "$schema": "./schema/reminders.schema.json",
  "description": "Reminder planning: the notifications created for every trigger date from the last run's date to today, both inclusive. Renewal, trial-ending and ending triggers are skipped when their event is before today or their payment is no longer expected; overdue fires once while the payment is expected. The dedupe key uses the trigger date, and a key that already exists creates nothing.",
  "rules": [
    "BR-13",
    "BR-14",
    "BR-15",
    "BR-16",
    "BR-17",
    "BR-19",
    "BR-20",
    "BR-23",
    "BR-24",
    "BR-27"
  ],
  "cases": [
    {
      "id": "renewal-fires-the-default-days-before",
      "rules": ["BR-13", "BR-24"],
      "description": "With the default lead time of 3 days, a payment due on 2026-11-24 gets an info renewal notification today, carrying the name, due date and amount.",
      "input": {
        "last_run_date": "2026-11-21",
        "today": "2026-11-21",
        "settings": {
          "default_reminder_days": 3,
          "trial_reminder_days": 3,
          "yearly_reminder_days": 14,
          "ending_reminder_days": 7
        },
        "subscriptions": [
          {
            "id": 1,
            "name": "Spotify",
            "interval": {
              "count": 1,
              "unit": "month"
            },
            "status": "active",
            "archived": false,
            "reminder_days": null
          }
        ],
        "payments": [
          {
            "id": 10,
            "subscription_id": 1,
            "due_date": "2026-11-24",
            "expected_cents": 1199,
            "status": "expected"
          }
        ],
        "existing_dedupe_keys": []
      },
      "expected": {
        "notifications": [
          {
            "type": "renewal",
            "severity": "info",
            "trigger_date": "2026-11-21",
            "dedupe_key": "renewal:1:2026-11-21",
            "subscription_id": 1,
            "payment_id": 10,
            "params": {
              "name": "Spotify",
              "date": "2026-11-24",
              "amount_cents": 1199
            }
          }
        ]
      }
    },
