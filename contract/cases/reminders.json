            "type": "overdue",
            "severity": "critical",
            "trigger_date": "2026-11-21",
            "dedupe_key": "overdue:3:2026-11-21",
            "subscription_id": 3,
            "payment_id": 30,
            "params": {
              "name": "Proton VPN",
              "date": "2026-11-20",
              "amount_cents": 999
            }
          }
        ]
      }
