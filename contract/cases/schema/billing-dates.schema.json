{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "billing-dates.schema.json",
  "title": "BR-1, BR-2: billing dates computed from the anchor",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "description", "rules", "cases"],
  "properties": {
    "$schema": {
      "const": "./schema/billing-dates.schema.json"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "description": "The rules this file covers. Each one appears in at least one case.",
      "const": ["BR-1", "BR-2"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rules", "description", "input", "expected"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/caseId"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/ruleId"
                },
                {
                  "enum": ["BR-1", "BR-2"]
                }
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["anchor", "interval", "count"],
            "properties": {
              "anchor": {
                "$ref": "common.schema.json#/$defs/date",
                "description": "First billing date (n = 0)."
              },
              "interval": {
                "$ref": "common.schema.json#/$defs/interval"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "How many dates to compute: n = 1 to count."
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dates"],
            "properties": {
              "dates": {
                "description": "anchor + n × interval for n = 1 to count, clamped to the last day of a shorter month.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/date"
                }
              }
            }
          }
        }
      }
    }
  }
}
